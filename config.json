{
  "_comment": "CureControl Oven Controller Configuration",

  "serial": {
    "port": "auto",
    "baud_rate": 115200,
    "timeout": 2.0,
    "vid": null,
    "pid_usb": null,
    "auto_poll": false
  },

  "_protocol_note": "PCB broadcasts status automatically ~4x/sec. Format is positional pipe-delimited:",
  "_status_format": "<STATE|TIMER|?|SETPOINT|TC1_AVG (RAW1,RAW2)|TC2|HEATER|FAN|LIGHT|?|PID|?|DURATION_MIN|?>",
  "_status_example": "<IDLE|0:00:00|1|400|62.92 (62.60, 63.05)|73.40|0|0|0|0|0.00|1|30|0>",

  "pid": {
    "kp": 2.0,
    "ki": 0.05,
    "kd": 1.0,
    "output_min": 0,
    "output_max": 100,
    "sample_time": 1.0
  },

  "temperature": {
    "max_safe_temp": 450,
    "units": "F",
    "primary_thermocouple": 1
  },

  "commands": {
    "_note": "Commands from live PCB serial captures (pcb_output.txt/2/4, May 2026)",
    "_confirmed": "LightOn/LightOff/FanOn/FanOff/WarmUp/Start ALL CONFIRMED from serial captures.",
    "_states_confirmed": "IDLE / WARMING UP / AT TEMP / CURING all confirmed. AT TEMP = at setpoint waiting for Start, or holding after cure completes.",
    "_unconfirmed": "Cancel/Temperature/CureTime not yet observed — educated guesses.",

    "fan_on":          "FanOn",
    "fan_off":         "FanOff",
    "fan_speed":       "FanSpeed={value}",

    "light_on":        "LightOn",
    "light_off":       "LightOff",

    "warm_up":         "WarmUp",
    "start_cure":      "Start",
    "cancel_cure":     "Cancel",

    "_stay_warm_note": "Stay warm commands are educated guesses — verify against PCB",
    "stay_warm_on":    "StayOn",
    "stay_warm_off":   "StayOff",

    "_temp_note": "Temperature and cure time commands not yet confirmed — verify against PCB before use",
    "set_temperature": "Temperature={value}",
    "set_cure_time":   "CureTime={hours}:{minutes}:{seconds}"
  },

  "server": {
    "host": "0.0.0.0",
    "port": 5000,
    "debug": false
  },

  "github": {
    "username": "hube268",
    "repo": "cure-oven-controller",
    "branch": "main"
  },

  "cure": {
    "min_temp_delta_to_start_timer": 2.0,
    "cool_down_temp": 100
  }
}
