[Unit]
Description=Cure Oven Controller Backend
After=network.target
Wants=network.target

[Service]
Type=simple
User=SERVICE_USER_PLACEHOLDER
WorkingDirectory=/home/pi/cure-oven-controller
ExecStart=/home/pi/cure-oven-controller/venv/bin/python src/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
